<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
          "-//Puppy Crawl//DTD Checkstyle Configuration 1.3//EN"
          "https://checkstyle.org/dtds/configuration_1.3.dtd">

<module name="Checker" version="1.0">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="warning"/>
    
    <!-- Suppress warnings -->
    <suppress warnings="true"/>
    
    <!-- File filters -->
    <suppress files>
        <exclude>**/test/**</exclude>
    </suppress>
    
    <!-- Suppress checks -->
    <suppress checks="true" check="LineLength">
        <property name="maxLineLength" value="120"/>
    </suppress>
    
    <suppress checks="true" check="MagicNumber">
        <property name="ignoreHashCode" value="-16777216"/>
    </suppress>
    
    <suppress checks="true" check="HiddenField">
        <property name="ignoreFormat" value="^(this)$"/>
    </suppress>
    
    <suppress checks="true" check="MethodLength">
        <property name="max" value="250"/>
    </suppress>
    
    <suppress checks="true" check="ParameterName">
        <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
    </suppress>
    
    <suppress checks="true" check="FinalParameters">
        <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
    </suppress>
    
    <suppress checks="true" check="FinalClass">
        <property name="format" value=".*Config$.*"/>
    </suppress>
    
    <suppress checks="true" check="JavadocMethod">
        <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
    </suppress>
    
    <suppress checks="true" check="JavadocVariable">
        <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
    </suppress>
    
    <suppress checks="true" check="JavadocPackage">
        <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
    </suppress>
    
    <suppress checks="true" check="NewlineAtEndOfFile"/>
    </suppress>
    
    <suppress checks="true" check="VisibilityModifier">
        <property name="protectedAllowed" value="public,protected| protected"/>
    </suppress>
    
    <suppress checks="true" check="FileTabCharacter">
        <property name="fileExtensions" value="java"/>
    </suppress>
</module>
